# ============================================================
# Digital Document Signing System — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ─── Database ───────────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=docsign
DB_USER=docsign
DB_PASSWORD=docsign_secure_pass_2025

# MySQL root password (used for init only)
MYSQL_ROOT_PASSWORD=root_secure_pass_2025

# ─── JWT Configuration ──────────────────────────────────────
# RS256: private key signs tokens, public key verifies
# Keys are auto-generated on first startup and persisted at /app/keys/
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Encryption ─────────────────────────────────────────────
# Master key for Fernet encryption of signatures & MFA secrets
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=your-32-byte-base64-fernet-key-here

# ─── SMTP Email Configuration ───────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=DocSign Platform <your-email@gmail.com>

# ─── Internal Service URLs (Docker network names) ───────────
AUTH_SERVICE_URL=http://auth-service:8001
DOCUMENT_SERVICE_URL=http://document-service:8002
NOTIFICATION_SERVICE_URL=http://notification-service:8003
FRONTEND_URL=http://localhost:3000

# ─── CORS Configuration ─────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost,http://localhost:80

# ─── Internal API Security ──────────────────────────────────
# Shared secret for service-to-service calls — prevents external callers
# from hitting internal-only endpoints
INTERNAL_API_KEY=change-this-to-a-random-256-bit-secret

# ─── Storage ────────────────────────────────────────────────
PDF_STORAGE_PATH=/app/storage/pdfs

# ─── Application Settings ───────────────────────────────────
# The display name shown on generated PDFs and emails
ORG_NAME=My Organization
ORG_TAGLINE=Digital Document Management System
